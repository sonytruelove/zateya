<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnRisky="true"
         cacheDirectory="build/phpunit"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
            <directory>app</directory>
        </include>
        <exclude>
            <!-- Адаптеры, которым нужны живые внешние сервисы: покрываются -->
            <!-- интеграционным окружением (docker compose) и отдельной задачей конвейера. -->
            <directory>src/Infrastructure/Console</directory>
            <file>src/Infrastructure/Leaderboard/RedisLeaderboardStore.php</file>
            <file>src/Infrastructure/Balance/RedisAttemptBalance.php</file>
            <file>src/Infrastructure/RateLimit/RedisRateLimiter.php</file>
            <file>src/Infrastructure/Session/RedisParticipantSessions.php</file>
            <file>src/Infrastructure/Realtime/CentrifugoPublisher.php</file>
            <file>src/Infrastructure/Messaging/RabbitMqEventPublisher.php</file>
        </exclude>
    </source>
    <coverage>
        <report>
            <text outputFile="php://stdout" showOnlySummary="true"/>
        </report>
    </coverage>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_DEBUG" value="false"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELEGRAM_WEBHOOK_SECRET" value="test-telegram-secret"/>
        <env name="VK_CONFIRMATION_TOKEN" value="test-vk-confirm"/>
        <env name="VK_SECRET_KEY" value="test-vk-secret"/>
        <env name="VK_APP_SECRET" value="test-vk-app-secret"/>
        <env name="ADMIN_API_TOKEN" value="test-admin-token"/>
        <env name="DEFAULT_CAMPAIGN_SLUG" value="demo"/>
        <env name="CENTRIFUGO_ENABLED" value="false"/>
        <env name="RABBITMQ_ENABLED" value="false"/>
        <env name="ZATEYA_LEADERBOARD_DRIVER" value="array"/>
        <env name="ZATEYA_BALANCE_DRIVER" value="array"/>
        <env name="ZATEYA_RATE_LIMITER_DRIVER" value="array"/>
        <env name="ZATEYA_SESSIONS_DRIVER" value="array"/>
    </php>
</phpunit>
