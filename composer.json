{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "zateya/platform",
    "type": "project",
    "description": "Затея — платформа запуска геймифицированных промо-механик и мотивационных программ.",
    "keywords": ["laravel", "promo", "gamification", "clean-architecture"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.17",
        "laravel/octane": "^2.5",
        "laravel/tinker": "^3.0",
        "predis/predis": "^2.2",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "require-dev": {
        "behat/behat": "^3.14",
        "deptrac/deptrac": "^3.0",
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.64",
        "infection/infection": "^0.29",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.5.12",
        "rector/rector": "^2.0",
        "webmozart/assert": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Src\\": "src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php artisan test",
        "cs": "php-cs-fixer fix --diff",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "stan": "phpstan analyse --memory-limit=512M",
        "rector": "rector process --dry-run",
        "layers": "deptrac analyse --config-file=deptrac.yaml",
        "mutation": "infection --min-msi=72 --min-covered-msi=72 --threads=4 --only-covered",
        "complexity": "phpmd src ansi phpmd.xml",
        "gauntlet": [
            "@cs:check",
            "@stan",
            "@layers",
            "@complexity",
            "@test",
            "@mutation"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
