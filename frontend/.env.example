# Базовый адрес REST API.
VITE_API_BASE=/api/v1

# МОК-режим API. Включён по умолчанию, чтобы страница работала без бэкенда.
# Поставьте false, когда доступен настоящий сервер по адресу VITE_API_BASE.
VITE_API_MOCK=true

# Адрес Centrifugo для живого рейтинга. Если пусто — работает встроенный эмулятор.
VITE_CENTRIFUGO_URL=
VITE_CENTRIFUGO_TOKEN=
