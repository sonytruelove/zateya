APP_NAME=Затея
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# --- Хранилище ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=zateya
DB_USERNAME=zateya
DB_PASSWORD=zateya

# --- Redis: рейтинг, баланс попыток, ограничение частоты, сессии участников ---
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# --- Выбор реализаций портов: redis | array ---
ZATEYA_LEADERBOARD_DRIVER=redis
ZATEYA_BALANCE_DRIVER=redis
ZATEYA_RATE_LIMITER_DRIVER=redis
ZATEYA_SESSIONS_DRIVER=redis
ZATEYA_REDIS_CONNECTION=default

# --- Веб-сокеты (Centrifugo) ---
CENTRIFUGO_ENABLED=true
CENTRIFUGO_API_URL=http://centrifugo:8000/api
CENTRIFUGO_API_KEY=changeme-centrifugo-api-key
CENTRIFUGO_TOKEN_HMAC_SECRET=changeme-centrifugo-hmac-secret

# --- Брокер сообщений (RabbitMQ) ---
RABBITMQ_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=zateya
RABBITMQ_PASSWORD=zateya
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=zateya.domain-events

# --- Долгоживущее приложение (Laravel Octane на RoadRunner) ---
OCTANE_SERVER=roadrunner

# --- Кампания по умолчанию для входящих сообщений каналов ---
DEFAULT_CAMPAIGN_SLUG=demo

# --- Маркер организатора для административного интерфейса ---
ADMIN_API_TOKEN=changeme-admin-token

# --- Telegram-бот ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=changeme-telegram-webhook-secret

# --- VK ---
VK_CONFIRMATION_TOKEN=
VK_SECRET_KEY=changeme-vk-secret
VK_APP_SECRET=
